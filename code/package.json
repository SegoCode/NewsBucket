{
	"name": "news-wired",
	"version": "1.0.0",
	"description": "RSS/Atom feed reader",
	"type": "module",
	"scripts": {
		"feeds": "node js/fetch-feeds.js",
		"perplexity": "node js/perplexity.js",
		"validate-feeds": "node js/validate-feeds.js",
		"cluster": "node js/cluster-news.js",
		"translate": "node js/translate-clusters.js",
		"validate-clusters": "node js/validate-clusters.js",
		"pipeline": "pnpm run feeds && pnpm run validate-feeds && pnpm run cluster && pnpm run translate && pnpm run validate-clusters",
		"test": "node --test js/test/*.test.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@toon-format/toon": "^2.3.0",
		"dotenv": "^17.4.2",
		"eventsource-parser": "^3.1.0",
		"html-to-text": "^9.0.5",
		"jsonrepair": "^3.14.0",
		"normalize-url": "^8.0.1",
		"rss-parser": "^3.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0"
	}
}
